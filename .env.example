AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional. Leave unset to authenticate with AzureCliCredential (az login).
# AZURE_OPENAI_API_KEY=
# Optional, only needed for the email workflows (Gmail shown; the code uses SMTP over SSL, port 465).
# EMAIL_RECIPIENT=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
