# Azure OpenAI Configuration (Required)
# Get these from your Azure OpenAI resource
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI Authentication
# Option 1: Leave unset to use AzureCliCredential (local: az login required)
# Option 2: Set to use explicit API key (for containers or when az login unavailable)
# In Azure Container Apps: Use managed identity (leave unset)
# AZURE_OPENAI_API_KEY=

# Email Workflow Configuration (Optional)
# Only needed for approval_workflow.py (sends real emails)
# Recommendation: Store in Key Vault for production, .env for local dev

# Email recipient(s) for approval workflow
# EMAIL_RECIPIENT=

# SMTP Server Configuration
# Gmail example shown; modify for your email provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# Note: Gmail app passwords contain spaces; the code strips them automatically.
# See: https://support.google.com/accounts/answer/185833
