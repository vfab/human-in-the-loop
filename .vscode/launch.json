{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Email Assistant Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app_server:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Concurrent Request Info (Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/concurrent_request_info.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Group Chat Request Info (Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/group_chat_request_info.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Sequential Request Info (Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sequential_request_info.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Agents with Approval Requests (Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agents_with_approval_requests.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Guessing Game with Human Input (Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/guessing_game_with_human_input.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "python: venv check"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "All Demos (Concurrent + Group Chat + Sequential + Approval + Game)",
            "configurations": [
                "Concurrent Request Info (Demo)",
                "Group Chat Request Info (Demo)",
                "Sequential Request Info (Demo)",
                "Agents with Approval Requests (Demo)",
                "Guessing Game with Human Input (Demo)"
            ],
            "stopAll": true
        },
        {
            "name": "All with FastAPI Server",
            "configurations": [
                "FastAPI: Email Assistant Server",
                "Concurrent Request Info (Demo)",
                "Group Chat Request Info (Demo)",
                "Sequential Request Info (Demo)",
                "Agents with Approval Requests (Demo)",
                "Guessing Game with Human Input (Demo)"
            ],
            "stopAll": true
        }
    ]
}