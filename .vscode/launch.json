{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HITL Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "serverReadyAction": {
                "pattern": "Uvicorn running on https?://127\\.0\\.0\\.1:([0-9]+)",
                "uriFormat": "http://127.0.0.1:%s/",
                "action": "openIntegratedBrowser"
            }
        }
    ]
}